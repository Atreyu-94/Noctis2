        "publisherDisplayName": "Liviu Schera"
    },
    "type": "module",
    "devDependencies": {
        "@types/node": "26.6.5",
        "typescript": "7.0.2",
        "vscode-oniguruma": "2.0.1",
        "vscode-textmate": "9.3.2"
    }
}

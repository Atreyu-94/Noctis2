{
    "name": "noctis",
    "displayName": "Noctis2",
    "description": "Noctis is a collection of light & dark themes with a well balanced blend of warm and cold colors",
    "version": "10.43.3",
    "publisher": "liviuschera",
    "icon": "images/logo.png",
    "engines": {
        "vscode": "^1.43.0"
    },
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "galleryBanner": {
        "color": "#052529",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/liviuschera/noctis"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "compile": "tsc",
        "build": "npm run compile && node dist/build.js",
        "test": "npm run compile && node --test tests/*.test.mjs",
        "check": "npm run typecheck && npm test",
        "inspect:tinymist": "node scripts/inspect-tinymist.mjs",
        "test:languages": "npm run build && node scripts/validate-languages.mjs"
    },
    "categories": [
        "Themes",
        "Other"
    ],
    "keywords": [
        "noctis",
        "blue",
        "azure",
        "semantic",
        "italic",
        "bold"
    ],
    "contributes": {
        "themes": [
            {
                "label": "Noctis2 Lux",
                "uiTheme": "vs",
                "path": "./themes/lux.json"
            },
            {
                "label": "Noctis2 Hibernus",
                "uiTheme": "vs",
                "path": "./themes/hibernus.json"
            },
            {
                "label": "Noctis2 Lilac",
                "uiTheme": "vs",
                "path": "./themes/lilac.json"
            },
            {
                "label": "Noctis2",
                "uiTheme": "vs-dark",
                "path": "./themes/noctis.json"
            },
            {
                "label": "Noctis2 Azureus",
                "uiTheme": "vs-dark",
                "path": "./themes/azureus.json"
            },
            {
                "label": "Noctis2 Bordo",
                "uiTheme": "vs-dark",
                "path": "./themes/bordo.json"
            },
            {
                "label": "Noctis2 Obscuro",
                "uiTheme": "vs-dark",
                "path": "./themes/obscuro.json"
            },
            {
                "label": "Noctis2 Sereno",
                "uiTheme": "vs-dark",
                "path": "./themes/sereno.json"
            },
            {
                "label": "Noctis2 Uva",
                "uiTheme": "vs-dark",
                "path": "./themes/uva.json"
            },
            {
                "label": "Noctis2 Viola",
                "uiTheme": "vs-dark",
                "path": "./themes/viola.json"
            },
            {
                "label": "Noctis2 Minimus",
                "uiTheme": "vs-dark",
                "path": "./themes/minimus.json"
            }
        ]
    },
    "__metadata": {
        "id": "d4e2a48f-0b88-4540-92c5-a4ab4dd2c813",
